# Postgres
POSTGRES_USER=indexbeef
POSTGRES_PASSWORD=indexbeef
POSTGRES_DB=indexbeef
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=indexbeef
MINIO_ROOT_PASSWORD=indexbeef-dev
MINIO_ENDPOINT=http://minio:9000
